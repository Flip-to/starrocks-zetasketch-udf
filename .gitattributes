* text=auto eol=lf

# Force LF for files that must run on POSIX (CI runners, container envs)
mvnw         text eol=lf
*.sh         text eol=lf
*.yml        text eol=lf
*.yaml       text eol=lf
*.java       text eol=lf
*.xml        text eol=lf
*.json       text eol=lf
*.properties text eol=lf

# Windows-only scripts
*.cmd        text eol=crlf
*.bat        text eol=crlf

# Binaries
*.jar        binary
*.png        binary
*.jpg        binary
